<%@ tag pageEncoding="UTF-8" %><%@ attribute name="banner" required="true" type="iuh.fit.www_phone_ver1.entity.CampaignBanner" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="campaign-banner ${banner.theme == 'DARK' ? 'campaign-dark' : ''} ${banner.placement == 'TILE' ? 'campaign-tile' : ''}" data-reveal><div><span class="eyebrow">PTV MOBILE</span><h2><c:out value="${banner.title}"/></h2><p><c:out value="${banner.subtitle}"/></p><a class="btn btn-brand" href="${pageContext.request.contextPath}${banner.targetPath}"><c:out value="${banner.actionLabel}"/></a></div><c:if test="${not empty banner.imagePath}"><img src="${pageContext.request.contextPath}${banner.imagePath}" alt="<c:out value='${banner.imageLabel}'/>" loading="lazy"></c:if></section>
