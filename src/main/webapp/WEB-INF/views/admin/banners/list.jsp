<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<jsp:include page="/WEB-INF/views/shared/admin/header.jsp"/>
<div class="section-heading"><p>Lịch hiển thị theo giờ Việt Nam. Thứ tự nhỏ hơn được ưu tiên trước.</p><a class="btn btn-brand" href="${pageContext.request.contextPath}/admin/banners/new">Thêm banner</a></div><div class="address-grid"><c:forEach var="b" items="${banners}"><article class="panel"><c:if test="${not empty b.imagePath}"><img class="image-preview" src="${pageContext.request.contextPath}${b.imagePath}" alt="<c:out value='${b.imageLabel}'/>"></c:if><h2><c:out value="${b.title}"/></h2><p><c:out value="${b.subtitle}"/></p><p><c:out value="${b.scheduleLabel}"/> (GMT+7)</p><p>${b.active ? 'Cho phép hiển thị theo lịch' : 'Đang tắt'} · ${b.placement == 'HERO' ? 'Khối giới thiệu chính' : 'Thẻ chiến dịch'} · Thứ tự ${b.position}</p><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/admin/banners/${b.id}/edit">Sửa banner</a><form class="mt-3" method="post" action="${pageContext.request.contextPath}/admin/banners/${b.id}/delete" data-confirm="Xóa banner này?"><ui:csrf/><input type="hidden" name="version" value="${b.version}"><button class="btn btn-outline-danger">Xóa banner</button></form></article></c:forEach></div><c:if test="${empty banners}"><div class="panel empty-state"><h2>Chưa có banner chiến dịch</h2><p>Trang chủ đang dùng sản phẩm trình bày trong Nội dung cửa hàng. Thêm banner để thay khối giới thiệu theo lịch.</p></div></c:if>
<jsp:include page="/WEB-INF/views/shared/admin/footer.jsp"/>
