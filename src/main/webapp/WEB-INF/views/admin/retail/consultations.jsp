<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<jsp:include page="/WEB-INF/views/shared/admin/header.jsp"/>
<c:if test="${empty requests}"><div class="panel empty-state"><h2>Chưa có yêu cầu tư vấn</h2><p>Yêu cầu trả góp và thu cũ của khách sẽ hiển thị tại đây.</p></div></c:if>
<div class="address-grid"><c:forEach var="r" items="${requests}"><article class="panel"><span class="eyebrow">#${r.id} · <c:out value="${r.typeLabel}"/></span><h2><c:out value="${r.product.name}"/></h2><span class="status-badge"><c:out value="${r.statusLabel}"/></span><p><strong><c:out value="${r.contactName}"/></strong> · <c:out value="${r.phone}"/></p><p class="description"><c:out value="${r.message}"/></p><c:if test="${not empty r.response}"><p>Phản hồi: <c:out value="${r.response}"/></p></c:if><c:if test="${r.quotedAmount != null}"><p>Phương án: <ui:money value="${r.quotedAmount}"/></p></c:if>
<c:if test="${r.status == 'REQUESTED' or r.status == 'CONTACTED' or r.status == 'QUOTED'}"><form method="post" action="${pageContext.request.contextPath}/admin/consultations/${r.id}"><ui:csrf/><input type="hidden" name="version" value="${r.version}"><div class="field"><label for="status-${r.id}">Bước xử lý</label><select id="status-${r.id}" name="status" class="form-select"><c:if test="${r.status == 'REQUESTED'}"><option value="CONTACTED">Tiếp nhận</option></c:if><c:if test="${r.status == 'CONTACTED' or r.status == 'QUOTED'}"><option value="QUOTED">Gửi / cập nhật phương án</option></c:if><c:if test="${r.status == 'QUOTED'}"><option value="ACCEPTED">Duyệt sau khi đã xác nhận với khách</option></c:if><option value="REJECTED">Không phù hợp</option></select></div><div class="field"><label for="amount-${r.id}">Giá trị phương án (đồng)</label><input id="amount-${r.id}" class="form-control" name="amount" type="number" min="0" step="1" max="1000000000" value="${r.quotedAmount}"></div><div class="field"><label for="response-${r.id}">Phản hồi và điều kiện cho khách</label><textarea id="response-${r.id}" class="form-control" name="response" required maxlength="1500" rows="3"><c:out value="${r.response}"/></textarea></div><button class="btn btn-brand">Cập nhật yêu cầu #${r.id}</button></form></c:if></article></c:forEach></div>
<jsp:include page="/WEB-INF/views/shared/admin/footer.jsp"/>
