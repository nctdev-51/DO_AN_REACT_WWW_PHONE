<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<jsp:include page="/WEB-INF/views/shared/store/header.jsp"/>
<section class="discovery-intro"><span class="eyebrow">BẮT ĐẦU TỪ NHU CẦU CỦA BẠN</span><h1>Chiếc máy tiếp theo.<br>Vừa với ngân sách.</h1><p>Chọn mức chi và hãng yêu thích. Bạn có thể so sánh các cấu hình trước khi quyết định.</p></section>
<form class="panel filter-grid" method="get" action="${pageContext.request.contextPath}/choose"><div><label for="budget">Ngân sách tối đa (đồng)</label><input id="budget" name="budget" type="number" min="1000000" max="100000000" step="100000" value="${empty budget ? 15000000 : budget}" class="form-control" required></div><div><label for="choose-brand">Hãng mong muốn</label><select id="choose-brand" name="brand" class="form-select"><option value="">Tất cả hãng</option><c:forEach var="b" items="${brands}"><option value="<c:out value='${b}'/>" ${brand == b ? 'selected' : ''}><c:out value="${b}"/></option></c:forEach></select></div><div><label for="choose-purpose">Nhu cầu chính</label><select id="choose-purpose" name="purpose" class="form-select"><option value="">Chưa xác định</option><option value="EVERYDAY" ${purpose == 'EVERYDAY' ? 'selected' : ''}>Sử dụng hằng ngày</option><option value="CAMERA" ${purpose == 'CAMERA' ? 'selected' : ''}>Chụp ảnh</option><option value="GAMING" ${purpose == 'GAMING' ? 'selected' : ''}>Chơi game</option><option value="BATTERY" ${purpose == 'BATTERY' ? 'selected' : ''}>Ưu tiên pin</option><option value="COMPACT" ${purpose == 'COMPACT' ? 'selected' : ''}>Thiết kế gọn</option></select></div><button class="btn btn-brand">Xem lựa chọn còn hàng</button></form>
<c:if test="${not empty budget}"><div class="section-heading"><h2>Các lựa chọn trong ngân sách</h2><a href="${pageContext.request.contextPath}/compare">Mở bảng so sánh →</a></div><div class="product-grid"><c:forEach var="p" items="${matches}"><ui:productCard product="${p}"/></c:forEach></div><c:if test="${empty matches}"><div class="empty-state"><h2>Chưa có lựa chọn còn hàng phù hợp</h2><p>Thử tăng ngân sách hoặc chọn tất cả hãng.</p></div></c:if><p class="muted">Nhóm nhu cầu do cửa hàng phân loại, kết hợp giá và tồn kho; không phải điểm hiệu năng hoặc cam kết thời lượng pin. Xem camera, màn hình và pin trong thông số từng máy.</p></c:if>
<jsp:include page="/WEB-INF/views/shared/store/footer.jsp"/>
