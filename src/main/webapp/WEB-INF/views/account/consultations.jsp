<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<jsp:include page="/WEB-INF/views/shared/store/header.jsp"/><jsp:include page="/WEB-INF/views/shared/store/account-nav.jsp"/>
<div class="page-heading"><div><span class="eyebrow">PTV MOBILE HỖ TRỢ BẠN</span><h1>Trả góp & thu cũ.</h1><p>Gửi nhu cầu, nhận phương án phù hợp từ cửa hàng.</p></div><a href="${pageContext.request.contextPath}/account">Về tài khoản →</a></div>
<div class="retail-split"><section class="panel"><h2>Bắt đầu yêu cầu</h2><p class="muted">Phương án được nhân viên xem xét. Yêu cầu này chưa phải hợp đồng trả góp hay cam kết định giá máy cũ. Bạn không cần gửi CCCD hoặc thông tin tài chính tại đây.</p>
<form:form modelAttribute="consultationForm" method="post" action="${pageContext.request.contextPath}/account/consultations"><form:errors path="*" element="div" cssClass="alert alert-danger"/>
<div class="field"><label for="type">Bạn cần hỗ trợ gì?</label><form:select id="type" path="type" cssClass="form-select"><form:option value="INSTALLMENT">Tư vấn trả góp</form:option><form:option value="TRADE_IN">Thu cũ đổi mới</form:option></form:select></div>
<div class="field"><label for="productId">Sản phẩm muốn mua</label><form:select id="productId" path="productId" cssClass="form-select" required="required"><form:option value="">Chọn sản phẩm</form:option><c:forEach var="p" items="${products}"><form:option value="${p.id}"><c:out value="${p.name}"/></form:option></c:forEach></form:select></div>
<div class="field"><label for="contactName">Tên liên hệ</label><form:input id="contactName" path="contactName" cssClass="form-control" required="required" maxlength="100" autocomplete="name"/></div>
<div class="field"><label for="phone">Số điện thoại</label><form:input id="phone" path="phone" cssClass="form-control" required="required" pattern="0[0-9]{9}" maxlength="10" inputmode="tel" autocomplete="tel"/></div>
<div class="field"><label for="message">Mô tả nhu cầu</label><form:textarea id="message" path="message" cssClass="form-control" rows="4" minlength="10" maxlength="1500" required="required" aria-describedby="request-hint"/><small id="request-hint">Trả góp: khoản trả trước, kỳ hạn mong muốn. Thu cũ: tên máy, dung lượng và tình trạng sử dụng.</small></div><button class="btn btn-brand">Gửi yêu cầu tư vấn</button></form:form></section>
<section><h2>Yêu cầu của bạn</h2><c:if test="${empty requests}"><div class="panel empty-state"><p>Chưa có yêu cầu. Phản hồi của cửa hàng sẽ xuất hiện tại đây.</p></div></c:if><c:forEach var="r" items="${requests}"><article class="panel mb-3"><span class="eyebrow">#${r.id} · <c:out value="${r.typeLabel}"/></span><h3><c:out value="${r.product.name}"/></h3><span class="status-badge"><c:out value="${r.statusLabel}"/></span><p class="description"><c:out value="${r.message}"/></p><c:if test="${not empty r.response}"><h4>Phản hồi từ cửa hàng</h4><p class="description"><c:out value="${r.response}"/></p></c:if><c:if test="${r.quotedAmount != null}"><p>Giá trị phương án: <strong><ui:money value="${r.quotedAmount}"/></strong></p><small>Điều kiện cụ thể theo phản hồi của nhân viên.</small></c:if><c:if test="${r.status == 'REQUESTED' or r.status == 'CONTACTED' or r.status == 'QUOTED'}"><form method="post" action="${pageContext.request.contextPath}/account/consultations/${r.id}/cancel" class="mt-3"><ui:csrf/><input type="hidden" name="version" value="${r.version}"><button class="btn btn-outline-danger">Hủy yêu cầu #${r.id}</button></form></c:if></article></c:forEach></section></div>
<jsp:include page="/WEB-INF/views/shared/store/footer.jsp"/>
