# Docker Compose reads this file after you copy it to .env. Do not commit .env.
DB_URL=jdbc:mariadb://mariadb:3306/webshop_db
DB_USERNAME=webshop_app
DB_PASSWORD=replace-with-a-long-unique-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-unique-password
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
PUBLIC_BASE_URL=http://localhost:8080
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
GHN_ENABLED=false
GHN_TOKEN=
GHN_SHOP_ID=0
# Docker Compose defaults (override MONGODB_URI=mongodb://localhost:27017/ptv_mobile,
# MILVUS_ENABLED=false, MILVUS_HOST=localhost when running mvnw directly outside Docker)
MONGODB_URI=mongodb://mongodb:27017/ptv_mobile
OPENAI_API_KEY=placeholder
OPENAI_EMBEDDING_API_KEY=placeholder
MILVUS_ENABLED=true
MILVUS_HOST=milvus
MILVUS_PORT=19530
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=